# editor backups
*~

# python bytecode (e.g. from scripts under home/)
__pycache__/
*.py[cod]

# written by lazy.nvim on plugin updates, deliberately untracked
home/.config/nvim/lazy-lock.json
home/.config/nvim/lua/nvim.log

# private: ssh config, keys and known_hosts must never be committed
home/.ssh/
