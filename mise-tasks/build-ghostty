#!/usr/bin/env bash
#MISE description="Build ghostty from source into ~/apps/ghostty"
#MISE tools={zig="0.15.2"}
set -euo pipefail

# empty builds the tip release
PINNED_VERSION=""

SRC_ROOT="$HOME/.local/src"
INSTALL_DIR="$HOME/apps/ghostty"

if [[ -n "$PINNED_VERSION" ]]; then
    tarball_url="https://release.files.ghostty.org/${PINNED_VERSION}/ghostty-${PINNED_VERSION}.tar.gz"
else
    tarball_url="https://github.com/ghostty-org/ghostty/releases/download/tip/ghostty-source.tar.gz"
fi

mkdir -p "$SRC_ROOT"
cd "$SRC_ROOT"
wget "$tarball_url" -O ghostty-source.tar.gz
src_dir=$(tar tzf ghostty-source.tar.gz 2>/dev/null | head -1 | cut -d/ -f1 || true)
[[ -n "${src_dir}" ]] || { echo "ERROR: could not determine source directory from tarball"; exit 1; }
tar xf ghostty-source.tar.gz
rm ghostty-source.tar.gz

zig_extra_flags=("-fsys=fontconfig")
if ! pkg-config --exists gtk4-layer-shell-0; then
    zig_extra_flags+=("-fno-sys=gtk4-layer-shell")
fi

STAGING_DIR="${INSTALL_DIR}.new"
rm -rf "$STAGING_DIR"
mkdir -p "$STAGING_DIR"
(
    cd "${src_dir}"
    zig build -p "${STAGING_DIR}" -Doptimize=ReleaseFast "${zig_extra_flags[@]}"
)
rm -rf "${src_dir}"
# swap in only on success — preserves the old install if the build fails
rm -rf "$INSTALL_DIR"
mv "$STAGING_DIR" "$INSTALL_DIR"
symfarm "${INSTALL_DIR}"
