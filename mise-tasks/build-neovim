#!/usr/bin/env bash
#MISE description="Build neovim nightly from source into ~/apps/neovim"
set -euo pipefail

SRC_DIR="$HOME/.local/src/neovim"
INSTALL_DIR="$HOME/apps/neovim"

if [[ -d "$SRC_DIR" ]]; then
    cd "$SRC_DIR"
    git checkout master
    git pull
    git fetch --force --tags
else
    git clone https://github.com/neovim/neovim.git "$SRC_DIR"
    cd "$SRC_DIR"
fi
git checkout nightly

STAGING_DIR="${INSTALL_DIR}.new"
rm -rf "$STAGING_DIR"
mkdir -p "$STAGING_DIR"
make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX="${STAGING_DIR}"
make CMAKE_BUILD_TYPE=Release CMAKE_INSTALL_PREFIX="${STAGING_DIR}" install
# swap in only on success — preserves the old install if the build fails
rm -rf "$INSTALL_DIR"
mv "$STAGING_DIR" "$INSTALL_DIR"
symfarm -f "${INSTALL_DIR}"
