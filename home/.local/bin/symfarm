#!/usr/bin/env python3
"""symfarm.py - A minimal symlink farm manager similar to GNU Stow."""

import argparse
import os
import sys
from pathlib import Path


DEFAULT_FOLDERS = ["bin", "lib", "share", "man", "etc", "include", "lib64"]


def prune_empty_dirs(start: Path, stop: Path) -> None:
    """Remove empty directories walking up from start towards (but excluding) stop.

    Stops at the first non-empty directory, or once stop is reached.

    Args:
        start: The directory to start removing from.
        stop: The ancestor directory to stop at (never removed).
    """
    current = start
    while current != stop and current.is_relative_to(stop):
        try:
            current.rmdir()
            print(f"Removed empty directory: {current}")
        except OSError:
            break
        current = current.parent


def create_symlink(source: Path, target: Path, output_dir: Path, delete: bool = False, force: bool = False) -> None:
    """Create or delete a symlink.

    Args:
        source: The source file to link to.
        target: The symlink path to create.
        output_dir: The root output directory; pruning of emptied directories stops here.
        delete: If True, delete the symlink instead of creating it.
        force: If True, overwrite conflicting files or symlinks.
    """
    if delete:
        if target.is_symlink():
            resolved_target = target.resolve()
            resolved_source = source.resolve()
            if resolved_target == resolved_source:
                target.unlink()
                print(f"Deleted: {target}")
                prune_empty_dirs(target.parent, output_dir)
            else:
                print(f"Skipped (points elsewhere): {target}")
        elif target.exists():
            print(f"Skipped (not a symlink): {target}")
    else:
        # Create parent directories if they don't exist
        target.parent.mkdir(parents=True, exist_ok=True)

        if target.is_symlink():
            resolved_target = target.resolve()
            resolved_source = source.resolve()
            if resolved_target == resolved_source:
                print(f"Already exists: {target}")
            elif force:
                target.unlink()
                target.symlink_to(source)
                print(f"Replaced: {target} -> {source}")
            else:
                print(f"Conflict: {target} points to {resolved_target}")
        elif target.exists():
            if force:
                target.unlink()
                target.symlink_to(source)
                print(f"Replaced: {target} -> {source}")
            else:
                print(f"Conflict: {target} already exists (not a symlink)")
        else:
            target.symlink_to(source)
            print(f"Created: {target} -> {source}")


def collect_files_under(folder_path: Path) -> list[tuple[Path, Path]]:
    """Collect all files under a folder, preserving their relative path.

    Args:
        folder_path: The directory to walk.

    Returns:
        List of (source_path, relative_path) tuples, where relative_path
        is the path of source_path relative to folder_path.
    """
    results: list[tuple[Path, Path]] = []
    for root, _dirs, files in os.walk(folder_path):
        root_path = Path(root)
        for file in files:
            source = root_path / file
            results.append((source, source.relative_to(folder_path)))
    return results


def find_files_recursive(input_dir: Path, folders: list[str]) -> dict[str, list[tuple[Path, Path]]]:
    """Find files recursively in specified folders.

    Searches the input directory tree for any directory matching the folder names,
    and collects all files under them, preserving their relative path. So
    foo/bar/share/icons/hicolor/apps/x will create a symlink share/icons/hicolor/apps/x.

    Args:
        input_dir: The input directory to search.
        folders: List of folder names to search for.

    Returns:
        Dictionary mapping folder names to lists of (source_path, relative_path) tuples.
    """
    results: dict[str, list[tuple[Path, Path]]] = {folder: [] for folder in folders}

    for folder in folders:
        # Search for all occurrences of this folder name in the tree
        for root, dirs, _files in os.walk(input_dir):
            root_path = Path(root)

            # Check if current directory name matches our target folder
            if root_path.name == folder:
                results[folder].extend(collect_files_under(root_path))
                # Already captured everything below; don't look for nested matches inside it
                dirs[:] = []

    return results


def find_files_non_recursive(input_dir: Path, folders: list[str]) -> dict[str, list[tuple[Path, Path]]]:
    """Find files under direct subfolders of the input directory only.

    Only looks for bin/, lib/, share/, etc. as direct children of the input
    directory, but preserves the full relative path of files within them.

    Args:
        input_dir: The input directory to search.
        folders: List of folder names to search for.

    Returns:
        Dictionary mapping folder names to lists of (source_path, relative_path) tuples.
    """
    results: dict[str, list[tuple[Path, Path]]] = {folder: [] for folder in folders}

    for folder in folders:
        folder_path = input_dir / folder
        if folder_path.is_dir():
            results[folder].extend(collect_files_under(folder_path))

    return results


def process_symlinks(
    input_dir: Path,
    output_dir: Path,
    folders: list[str],
    recursive: bool = False,
    delete: bool = False,
    force: bool = False,
) -> None:
    """Process symlinks for the given directories.

    Creates or deletes symlinks from the output directory to files in the input directory.
    Only processes files in the specified folder names.

    Args:
        input_dir: The input directory containing files to link.
        output_dir: The output directory where symlinks will be created.
        folders: List of folder names to process (e.g., 'bin', 'lib', 'share').
        recursive: If True, search recursively for files.
        delete: If True, delete symlinks instead of creating them.
        force: If True, overwrite conflicting files or symlinks.
    """
    if recursive:
        files_map = find_files_recursive(input_dir, folders)
    else:
        files_map = find_files_non_recursive(input_dir, folders)

    for folder, files in files_map.items():
        for source, rel_path in files:
            target = output_dir / folder / rel_path
            create_symlink(source, target, output_dir, delete, force)


def main() -> None:
    """Main entry point for the script."""
    parser = argparse.ArgumentParser(
        description="A minimal symlink farm manager similar to GNU Stow.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s ~/myapp
    Create symlinks from ~/.local to files in ~/myapp/{bin,lib,share,...}

  %(prog)s ~/myapp -o ~/custom
    Create symlinks in ~/custom instead of ~/.local

  %(prog)s ~/myapp -r
    Recursively search for bin/, lib/, etc. folders anywhere in the tree

  %(prog)s ~/myapp -D
    Delete symlinks previously created from ~/myapp

  %(prog)s ~/myapp -f
    Overwrite conflicting files or symlinks
        """,
    )

    parser.add_argument(
        "input_dir",
        type=str,
        help="Input directory containing files to link",
    )

    parser.add_argument(
        "-o",
        "--output",
        type=str,
        default=os.path.expanduser("~/.local"),
        help="Output directory for symlinks (default: ~/.local)",
    )

    parser.add_argument(
        "-D",
        "--delete",
        action="store_true",
        help="Delete symlinks instead of creating them",
    )

    parser.add_argument(
        "-r",
        "--recursive",
        action="store_true",
        help="Search recursively in input dir for bin/, lib/, etc. folders anywhere in the tree",
    )

    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Overwrite conflicting files or symlinks",
    )

    parser.add_argument(
        "-i",
        "--include",
        type=str,
        nargs="+",
        default=DEFAULT_FOLDERS,
        help=f"Folders to process (default: {' '.join(DEFAULT_FOLDERS)})",
    )

    args = parser.parse_args()

    # Expand and resolve paths
    input_dir = Path(args.input_dir).expanduser().resolve()
    output_dir = Path(args.output).expanduser().resolve()

    # Validate input directory
    if not input_dir.exists():
        print(f"Error: Input directory does not exist: {input_dir}", file=sys.stderr)
        sys.exit(1)

    if not input_dir.is_dir():
        print(f"Error: Input path is not a directory: {input_dir}", file=sys.stderr)
        sys.exit(1)

    # Process symlinks
    process_symlinks(input_dir, output_dir, args.include, args.recursive, args.delete, args.force)


if __name__ == "__main__":
    main()
